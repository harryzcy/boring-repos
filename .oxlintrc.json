{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "style": "error"
  },
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    "bin/",
    "*.config.js",
    "*.config.ts",
    "dist/",
    "node_modules/"
  ],
  "rules": {
    "typescript/prefer-readonly-parameter-types": "off",
    "max-params": ["error", 5],
    "no-magic-numbers": [
      "error",
      {
        "ignore": [-1, 0, 1, 2],
        "ignoreArrayIndexes": true,
        "enforceConst": true,
        "detectObjects": false
      }
    ],
    "sort-imports": [
      "error",
      {
        "allowSeparatedGroups": true
      }
    ],
    "func-style": [
      "error",
      "declaration",
      {
        "allowArrowFunctions": true
      }
    ],
    "no-continue": "off"
  }
}
